# ── Auth ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-in-production

# ── InfluxDB ──────────────────────────────────────────
# Docker Image: influxdb
# Starten: docker start influxdb
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-api-token-here
INFLUX_ORG=MAGGIE
INFLUX_BUCKET=MAGGIE_DB

# ── PostgreSQL ────────────────────────────────────────
# Docker Image: postgres
# Starten: docker start postgres
POSTGRES_USER=maggie
POSTGRES_PASSWORD=maggie_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maggie_users

# ── OBC UDP-Interface (REXUS-Protokoll) ───────────────
# Port, auf dem der Server binäre OBC-Pakete empfängt
# OBC sendet UDP-Pakete (64 Bytes, Big-Endian) an diesen Port
UDP_HOST=0.0.0.0
UDP_PORT=9000
UDP_TIMEOUT=2.0

# ── RXSM Downlink (serieller Reader, read-only) ───────
# Port, an dem die 20-Byte-Downlink-Frames des OBC ankommen.
# Leer lassen → Port zur Laufzeit über /api/downlink/connect wählen.
SERIAL_PORT=
SERIAL_BAUD=38400
SERIAL_AUTOSTART=true

# ── RXSM Telecommand-Uplink (serieller TX, Motor-Steuerung) ──
# Separater Port zum RXSM-(Test-)Modul, über den Telecommands
# (SDC) an den OBC gesendet werden. Leer lassen → zur Laufzeit
# über /api/command/connect wählen.
TC_SERIAL_PORT=
TC_SERIAL_BAUD=38400
TC_AUTOSTART=true